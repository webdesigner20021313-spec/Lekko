# Lekko frontend — пример .env. Скопируйте в .env и заполните для deploy:
#   cp .env.example .env
#
# Замечания:
#   - VITE_* переменные ВПЕКАЮТСЯ в bundle при `docker compose build`.
#     После изменения требуется пересборка образа.
#   - FRONTEND_PORT и LEKKO_VERSION — runtime-параметры compose.

# ── Compose runtime ──────────────────────────────────────────────────────────
# Внешний порт nginx (80 = http, 8080 если корпоративный reverse-proxy).
FRONTEND_PORT=80

# Тег образа (для blue/green). Можно прибить timestamp/git-sha в CI.
LEKKO_VERSION=latest

# ── Build-args (Vite) ────────────────────────────────────────────────────────
# Sidecar-режим (фронт рядом с бэком на одном хосте, nginx проксирует /api+/hub):
#   оставьте пустым → фронт ходит на свой же origin, nginx форвардит на gateway.
# Standalone-режим (фронт на CDN, бэк на api.example.com):
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Cloudflare Turnstile site key (CAPTCHA на /login).
# Пустой → CAPTCHA-блок не рендерится; бэк тоже её скипает (см. TurnstileVerifier).
VITE_TURNSTILE_SITEKEY=
